# Copy this file to .env and set restrictive permissions: chmod 600 .env

# Runtime
TRADING_DASHBOARD_DB_PATH=/data/trading_dashboard.db
TRADING_DASHBOARD_FEE_POLICY_PATH=/app/config/fee-policies.json
TRADING_DASHBOARD_EXECUTION_HISTORY_DAYS=90
TRADING_DASHBOARD_SEED_DEMO=false

# External access is protected by Cloudflare Tunnel + Cloudflare Access.
# Keep application password authentication disabled for the single-user setup.
TRADING_DASHBOARD_AUTH_ENABLED=false
# Local password fallback is optional and should remain unset for Access-only operation.
# TRADING_DASHBOARD_VIEWER_PASSWORD_HASH=
# TRADING_DASHBOARD_OPERATOR_PASSWORD_HASH=
TRADING_DASHBOARD_SESSION_TTL_SECONDS=28800
TRADING_DASHBOARD_COOKIE_SECURE=false

# Logging and automated SQLite backups
TRADING_DASHBOARD_LOG_PATH=/data/trading_dashboard.log
TRADING_DASHBOARD_LOG_LEVEL=INFO
TRADING_DASHBOARD_BACKUP_DIR=/data/backups
TRADING_DASHBOARD_BACKUP_TIME=03:00
TRADING_DASHBOARD_BACKUP_RETENTION_DAYS=7

# Retry and rate-limit policy
TRADING_DASHBOARD_RETRY_MAX_ATTEMPTS=3
TRADING_DASHBOARD_RETRY_BACKOFF_SECONDS=0.25
TRADING_DASHBOARD_RETRY_MAX_BACKOFF_SECONDS=4
TRADING_DASHBOARD_API_MIN_INTERVAL_SECONDS=0.05

# Optional direct HTTPS reverse proxy. Not needed when Cloudflare Tunnel terminates HTTPS.
TRADING_DASHBOARD_DOMAIN=dashboard.example.com
TRADING_DASHBOARD_HTTP_PORT=80
TRADING_DASHBOARD_HTTPS_PORT=443

# Upbit
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_KEY_EXPIRES_ON=

# Korea Investment Securities
KIS_IS_PAPER=false
KIS_PENSION_APP_KEY=
KIS_PENSION_APP_SECRET=
KIS_PENSION_ACCOUNT_NO=
KIS_PENSION_ACCOUNT_PRODUCT_CODE=
KIS_PENSION_KEY_EXPIRES_ON=
KIS_PENSION_LABEL=연금저축
KIS_PENSION_CATEGORY=연금
KIS_ISA_APP_KEY=
KIS_ISA_APP_SECRET=
KIS_ISA_ACCOUNT_NO=
KIS_ISA_ACCOUNT_PRODUCT_CODE=
KIS_ISA_KEY_EXPIRES_ON=
KIS_ISA_LABEL=ISA중개형
KIS_ISA_CATEGORY=주식(국내)

# Toss Invest
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
TOSSINVEST_BASE_URL=https://openapi.tossinvest.com
TOSSINVEST_ACCOUNT_SEQ=
TOSSINVEST_KEY_EXPIRES_ON=
TOSSINVEST_ACCOUNT_LABEL=토스증권
TOSSINVEST_ACCOUNT_CATEGORY=주식(해외/국내)
